# Timewizzard local development
# Copy this file to .env.local and replace the placeholder values.

# Discord application / bot
CLIENT_ID=123456789012345678
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
GUILD_ID=123456789012345678

# Discord OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=PASTE_YOUR_OAUTH2_CLIENT_SECRET_HERE

# Local Web Builder URL. Keep this exactly in sync with the Discord OAuth2 redirect.
PUBLIC_BASE_URL=http://127.0.0.1:3000
PORT=3000

# Keep local test data isolated from Railway / production data.
DATA_DIR=./data-local
NODE_ENV=development

# Add this exact Redirect URL in Discord Developer Portal -> OAuth2 -> Redirects:
# http://127.0.0.1:3000/auth/discord/callback
