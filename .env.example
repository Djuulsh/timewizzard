# Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=123456789012345678

# Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Discord server ID. Enable Developer Mode and copy the server ID.
GUILD_ID=123456789012345678

# Local development: ./data
# Railway volume: /data (or the mount path you already use)
DATA_DIR=./data

# v1.2 Web Builder (optional locally, required for the web builder on Railway)
# Discord Developer Portal -> OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=PASTE_YOUR_OAUTH2_CLIENT_SECRET_HERE

# Your Railway public domain, without a trailing slash.
# Add this exact callback in Discord OAuth2 Redirects:
# https://YOUR-DOMAIN.up.railway.app/auth/discord/callback
PUBLIC_BASE_URL=https://YOUR-DOMAIN.up.railway.app

# Optional Web Builder GIF search. Create a Web API key at developers.giphy.com.
# GIPHY requires client-side API calls, so this key is delivered to authenticated Builder clients.
GIPHY_API_KEY=PASTE_YOUR_GIPHY_WEB_API_KEY_HERE

NODE_ENV=production
