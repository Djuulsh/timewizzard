{
  "name": "shrouded-info-bot",
  "version": "1.2.1",
  "private": true,
  "description": "Discord Components V2 information bot with Discord-native builder plus Railway-hosted OAuth drag-and-drop Web Builder.",
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "prestart": "npm run prepare:web",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "validate": "node scripts/validate.js && node --check scripts/prepare-web.mjs",
    "test": "npm run validate"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  }
}
